/* === WARNA DAN VARIABEL DASAR === */
:root {
    --primary-color: #1e293b;   /* Warna Slate Gelap */
    --accent-color: #2563eb;    /* Warna Biru Modern */
    --bg-color: #f8fafc;        /* Warna Latar Belakang */
    --text-color: #334155;      /* Warna Teks Utama */
}

/* === ELEMEN & RESET DASAR === */
body {
    font-family: 'Inter', sans-serif;
    background-color: var(--bg-color);
    color: var(--text-color);
    line-height: 1.6;
    margin: 0;
    padding: 0;
}

/* === CLASS & CONTAINER === */
.container {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 20px;
}

/* === ID SELECTOR === */
#main-header {
    background-color: var(--primary-color);
    color: #ffffff;
    padding: 20px 0;
    margin-bottom: 30px;
}

#main-footer {
    text-align: center;
    padding: 20px 0;
    background-color: var(--primary-color);
    color: #ffffff;
    margin-top: 40px;
}

/* === DESCENDANT SELECTOR === */
.blog-title {
    margin: 0;
    font-size: 24px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
}

.main-nav ul {
    list-style: none;
    padding: 0;
    margin: 10px 0 0 0;
}

.main-nav li {
    display: inline;
    margin-right: 15px;
}

.main-nav a {
    color: #cbd5e1;
    text-decoration: none;
    font-weight: 600;
}

/* === PSEUDO-CLASS (:hover) === */
.main-nav a:hover {
    color: #ffffff;
    text-decoration: underline;
}

/* Styling Artikel Utama */
article {
    background: #ffffff;
    padding: 30px;
    border-radius: 8px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
}

.article-header h2 {
    color: var(--primary-color);
    font-size: 28px;
    margin-bottom: 5px;
}

.article-header time {
    font-size: 14px;
    color: #64748b;
}

/* === CHILD SELECTOR (>) === */
.article-body > p {
    margin-bottom: 20px;
    text-align: justify;
}

blockquote {
    background-color: #f1f5f9;
    border-left: 4px solid var(--accent-color);
    margin: 20px 0;
    padding: 15px 20px;
    font-style: italic;
}

/* === PSEUDO-CLASS (:first-child) === */
.feature-list li:first-child {
    font-weight: 600;
    color: var(--accent-color);
}

.feature-list {
    margin-bottom: 20px;
}

.external-links p {
    margin: 5px 0;
}

.external-links a {
    color: var(--accent-color);
    text-decoration: none;
}

.external-links a:hover {
    text-decoration: underline;
}

.author-info {
    margin-top: 30px;
    border-top: 1px solid #e2e8f0;
    padding-top: 15px;
    font-size: 14px;
}

